DATABASE_URL="postgresql://funes_vault:funes_vault@localhost:5432/funes_vault?schema=public"
REDIS_URL="redis://localhost:6379"
BULL_BOARD_ENABLED="true"
CONSOLIDATION_CRON="0 3 * * *"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDINGS_MAX_SENSITIVITY="SECRET"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
# Optional for local demo login: pnpm dev enables Use demo account after seeding.
# Google Cloud -> Google Auth Platform -> Web application client.
# Register this exact callback; credentials stay server-side.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"
# OAuth for MCP connectors: public origin seen through the tunnel. Leave unset
# for local development (defaults to the API's localhost origin).
# OAUTH_ISSUER_URL="https://connect.example.com"
# MCP_CONNECTOR_MAX_SENSITIVITY="INTERNAL"

# Memory task providers. Leave selectors empty for credential-free vault use.
# Set system_1 for Jev (extraction additionally uses OpenAI normalization).
MEMORY_EXTRACTION_SYSTEM=
MEMORY_CONSOLIDATION_SYSTEM=
MEMORY_EXTRACTION_LLM_MODEL=
MEMORY_CONSOLIDATION_LLM_MODEL=
MEMORY_NORMALIZATION_LLM_MODEL=
MEMORY_EXTRACTION_JEV_MODEL=jev-1.13.0
MEMORY_CONSOLIDATION_JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
MEMORY_EXTRACTION_TIMEOUT_MS=15000
MEMORY_CONSOLIDATION_TIMEOUT_MS=60000
MEMORY_EXTRACTION_WRITE_MODE=policy
MEMORY_CONSOLIDATION_APPLY_MODE=user_setting
MEMORY_CONSOLIDATION_MAX_SENSITIVITY=INTERNAL
