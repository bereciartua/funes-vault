{
  "name": "@funes-vault/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e --project privacy-e2e",
    "test:coverage": "vitest run --project unit --project privacy-e2e --coverage",
    "smoke:memory-processing": "pnpm --filter @funes-vault/db exec tsx --tsconfig ../../apps/api/tsconfig.json ../../apps/api/scripts/memory-processing-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.3",
    "@bull-board/api": "^8.6.1",
    "@bull-board/express": "^8.6.1",
    "@funes-vault/db": "workspace:*",
    "@funes-vault/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "7.0.6",
    "bullmq": "^5.81.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "openai": "^6.49.0",
    "openid-client": "^6.8.8",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "@funes-vault/mcp": "workspace:*"
  },
  "license": "Apache-2.0",
  "files": [
    "dist"
  ]
}
