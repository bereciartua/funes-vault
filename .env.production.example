POSTGRES_USER=funes_vault
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=funes_vault

APP_DOMAIN=vault.example.com
API_DOMAIN=vault-api.example.com
MCP_DOMAIN=connect.example.com
APP_URL=https://vault.example.com
API_URL=https://vault-api.example.com
NEXT_PUBLIC_API_URL=https://vault-api.example.com
OAUTH_ISSUER_URL=https://connect.example.com
MCP_ALLOWED_HOSTS=connect.example.com

GOOGLE_CLIENT_ID=your-production-client-id
GOOGLE_CLIENT_SECRET=your-production-client-secret
GOOGLE_REDIRECT_URI=https://vault-api.example.com/auth/google/callback
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=cedar
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDINGS_MAX_SENSITIVITY=SECRET

BULL_BOARD_ENABLED=false
CONSOLIDATION_CRON=0 3 * * *
LOG_FORMAT=json
LOG_LEVELS=log,error,warn

# Memory task providers. Leave selectors empty for credential-free vault use.
# Set system_1 for Jev (extraction additionally uses OpenAI normalization).
MEMORY_EXTRACTION_SYSTEM=
MEMORY_CONSOLIDATION_SYSTEM=
MEMORY_EXTRACTION_LLM_MODEL=
MEMORY_CONSOLIDATION_LLM_MODEL=
MEMORY_NORMALIZATION_LLM_MODEL=
MEMORY_EXTRACTION_JEV_MODEL=jev-1.13.0
MEMORY_CONSOLIDATION_JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
MEMORY_EXTRACTION_TIMEOUT_MS=15000
MEMORY_CONSOLIDATION_TIMEOUT_MS=60000
MEMORY_EXTRACTION_WRITE_MODE=policy
MEMORY_CONSOLIDATION_APPLY_MODE=user_setting
MEMORY_CONSOLIDATION_MAX_SENSITIVITY=INTERNAL

# Published releases use e.g. 0.1.0; local builds use local.
FUNES_VAULT_IMAGE_REPO=ghcr.io/bereciartua/funes-vault
FUNES_VAULT_IMAGE_TAG=local
HTTP_BIND_ADDRESS=127.0.0.1

# Exact immediate Caddy peer IP(s); empty means forwarded headers are untrusted.
MCP_TRUSTED_PROXIES=
